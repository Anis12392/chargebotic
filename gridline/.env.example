# Copy to .env and fill in. Nothing here has a production-safe default.

# --- Environment -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false

# --- Database ----------------------------------------------------------------
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://gridline:change-me@localhost:5432/gridline

# --- Object storage ----------------------------------------------------------
# Leave the credentials blank to store photos on local disk instead of S3.
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=gridline-inspections
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_REGION=us-east-1

# --- Vision model ------------------------------------------------------------
# With no key the API runs its deterministic fallback analyzer, which observes
# nothing and says so in the report. That is the intended offline/CI mode.
OPENAI_API_KEY=
VISION_MODEL=gpt-4o
VISION_ENABLED=true

# --- GIS ---------------------------------------------------------------------
EXTERNAL_GIS_ENABLED=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
GIS_DEFAULT_RADIUS_M=400
GIS_CACHE_TTL_SECONDS=86400

# --- Security ----------------------------------------------------------------
# Required in production: without it the admin API refuses every request.
ADMIN_API_KEY=
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_ANALYZE_PER_MINUTE=20

# --- Frontend ----------------------------------------------------------------
# Baked into the client bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
